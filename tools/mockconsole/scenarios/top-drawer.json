{
  "schema": 1,
  "name": "top-drawer",
  "description": "Top Drawer: photo of a player, own photo in the manifest, drawing on it, SendDrawing, vote.",
  "players": 1,
  "auto": {
    "join": true,
    "resources": true,
    "session_id": 4242,
    "jokers": 2,
    "refuse": 0,
    "pending_ms": 0
  },
  "images": {
    "d2": {
      "w": 384,
      "h": 512,
      "color": "#aa3388",
      "label": "D2"
    }
  },
  "steps": [
    {
      "id": "join",
      "doc": "player 0 taps PLAY: hello, join handshake, assignment burst, empty manifest",
      "player": 0,
      "screen": "connect",
      "page": [
        {
          "do": "tap",
          "target": "connect-play"
        }
      ],
      "expect": [
        {
          "frame": "hello"
        },
        {
          "msg": "ClientRequestPlayerIDMessage",
          "fields": {
            "UID": "$uid:0"
          }
        },
        {
          "msg": "AllResourcesReceivedMessage",
          "fields": {
            "Requirements": {
              "eq": []
            }
          }
        }
      ],
      "timeout_ms": 20000
    },
    {
      "id": "photo",
      "doc": "the target takes the Top Drawer photo",
      "player": 0,
      "send": [
        {
          "msg": {
            "TypeString": "QuestionDataMessage",
            "RoundType": 1,
            "QuestionText": "Who has the messiest drawer?"
          }
        },
        {
          "msg": {
            "TypeString": "ClientTopDrawerTakePhotoCommandMessage",
            "action": 12,
            "time": 0.0,
            "CommandText": "Take a photo of {0}",
            "PlayerName": "Bob"
          }
        }
      ],
      "screen": "photo",
      "variant": "topdrawer",
      "page": [
        {
          "do": "tap",
          "target": "shutter"
        },
        {
          "do": "tap",
          "target": "use"
        }
      ],
      "expect": [
        {
          "msg": "TopDrawerPhotoTakenResponseMessage",
          "fields": {
            "Response": 11
          }
        },
        {
          "upload": {
            "ImgType": 3,
            "width": 480,
            "height": 640,
            "maxBytes": 128000
          },
          "capture": "td_photo"
        },
        {
          "msg": "TrophyPhotoFXInfoMessage",
          "fields": {
            "ImageGUID": "$cap:td_photo",
            "usesFX": {
              "type": "bool"
            }
          }
        },
        {
          "msg": "UsePicPressedResponseMessage",
          "fields": {
            "Response": 4
          }
        }
      ],
      "order": "any",
      "timeout_ms": 20000
    },
    {
      "id": "own-manifest",
      "doc": "the canvas (the page's own photo) is Required",
      "player": 0,
      "send": [
        {
          "manifest": [
            {
              "guid": "$cap:td_photo",
              "r": 1
            }
          ]
        }
      ],
      "expect": [
        {
          "msg": "AllResourcesReceivedMessage",
          "fields": {
            "Requirements": {
              "eq": [
                {
                  "GUID": "$cap:td_photo",
                  "Rqrmnt": 1
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "draw",
      "doc": "drawing confirmed by the player: upload ImgType 1 and colouring info on confirm, then look at TV",
      "player": 0,
      "send": [
        {
          "msg": {
            "TypeString": "ClientStartDrawingCommandMessage",
            "action": 7,
            "time": 0.0,
            "CanvasGUID": "$cap:td_photo"
          }
        }
      ],
      "screen": "draw",
      "variant": "topdrawer",
      "page": [
        {
          "do": "draw",
          "target": "draw-canvas",
          "points": [
            [
              0.2,
              0.2
            ],
            [
              0.8,
              0.3
            ],
            [
              0.5,
              0.8
            ]
          ],
          "steps": 12
        },
        {
          "do": "tap",
          "target": "colour-2"
        },
        {
          "do": "draw",
          "target": "draw-canvas",
          "points": [
            [
              0.2,
              0.2
            ],
            [
              0.8,
              0.3
            ],
            [
              0.5,
              0.8
            ]
          ],
          "steps": 12
        },
        {
          "do": "tap",
          "target": "draw-confirm"
        }
      ],
      "expect": [
        {
          "upload": {
            "ImgType": 1,
            "width": 384,
            "height": 512,
            "maxBytes": 128000
          },
          "capture": "td_draw"
        },
        {
          "msg": "TrophyDrawingColouringInfoMessage",
          "fields": {
            "ImageGUID": "$cap:td_draw",
            "ColoursAvailable": 32766,
            "ColoursUsed": {
              "ge": 0
            }
          }
        }
      ],
      "timeout_ms": 20000
    },
    {
      "id": "send-drawing",
      "doc": "SendDrawing (19) after a confirmed drawing: no second upload, the page stays on look at TV",
      "player": 0,
      "send": [
        {
          "msg": {
            "TypeString": "ClientQuizCommandMessage",
            "action": 19,
            "time": 0.0
          }
        }
      ],
      "screen": "holding",
      "variant": "look-at-tv",
      "expect": [
        {
          "none_ms": 1000
        }
      ]
    },
    {
      "id": "vote-manifest",
      "doc": "own drawing and another player's drawing are Required",
      "player": 0,
      "send": [
        {
          "manifest": [
            {
              "image": "d2",
              "r": 1
            },
            {
              "guid": "$cap:td_draw",
              "r": 1
            }
          ]
        }
      ],
      "expect": [
        {
          "msg": "RequestResourceMessage",
          "fields": {
            "ResourceGUID": "$guid:d2"
          }
        },
        {
          "msg": "AllResourcesReceivedMessage",
          "fields": {
            "Requirements": {
              "type": "array"
            }
          }
        }
      ],
      "order": "any",
      "timeout_ms": 15000
    },
    {
      "id": "vote",
      "doc": "drawing vote: the pick is sent at once",
      "player": 0,
      "send": [
        {
          "msg": {
            "TypeString": "ClientAnswerCommandMessage",
            "action": 3,
            "time": 0.0,
            "roundID": 1,
            "questionBarText": "Who has the messiest drawer?",
            "jokersEnabled": false,
            "ImageGUIDs": [
              "$guid:d2",
              "$cap:td_draw"
            ]
          }
        }
      ],
      "screen": "answer",
      "variant": "drawings",
      "page": [
        {
          "do": "tap",
          "target": "answer-1"
        },
        {
          "do": "tap",
          "target": "answer-confirm"
        }
      ],
      "expect": [
        {
          "msg": "AnswerIndexResponseMessage",
          "fields": {
            "AnswerIndex": 1
          }
        }
      ]
    }
  ]
}
