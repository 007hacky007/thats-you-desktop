{
  "schema": 1,
  "name": "thats-you",
  "description": "That's You: thumbnail, manifest of portraits, vote, SendAnswer, SendJoker, continue.",
  "players": 1,
  "auto": {
    "join": true,
    "resources": true,
    "session_id": 4242,
    "jokers": 2,
    "refuse": 0,
    "pending_ms": 0
  },
  "images": {
    "p1": {
      "w": 480,
      "h": 640,
      "color": "#cc6633",
      "label": "P1"
    },
    "p2": {
      "w": 480,
      "h": 640,
      "color": "#3366cc",
      "label": "P2"
    },
    "th": {
      "w": 128,
      "h": 128,
      "color": "#33aa55",
      "label": "T"
    }
  },
  "steps": [
    {
      "id": "join",
      "doc": "player 0 taps PLAY: hello, join handshake, assignment burst, empty manifest",
      "player": 0,
      "screen": "connect",
      "page": [
        {
          "do": "tap",
          "target": "connect-play"
        }
      ],
      "expect": [
        {
          "frame": "hello"
        },
        {
          "msg": "ClientRequestPlayerIDMessage",
          "fields": {
            "UID": "$uid:0"
          }
        },
        {
          "msg": "AllResourcesReceivedMessage",
          "fields": {
            "Requirements": {
              "eq": []
            }
          }
        }
      ],
      "timeout_ms": 20000
    },
    {
      "id": "roster",
      "doc": "game start: roster, game id, jokers, thumbnail push",
      "player": 0,
      "send": [
        {
          "msg": {
            "TypeString": "PlayerJoinedMessage",
            "CurrentPlayerID": 3,
            "OldPlayerID": 3,
            "SlotID": 1
          }
        },
        {
          "msg": {
            "TypeString": "PlayerNameQuizStateMessage",
            "PlayerName": "Bob",
            "PlayerID": 3
          }
        },
        {
          "msg": {
            "TypeString": "ClientGameIDMessage",
            "GameID": "2a6f1c0de-game"
          }
        },
        {
          "msg": {
            "TypeString": "SyncJokersQuizStateMessage",
            "NumJokers": 2
          }
        },
        {
          "content": {
            "header": {
              "TypeString": "PortraitThumbnailContentTransferMessage",
              "TransferID": "$tid",
              "ClientUID": "$uid:0"
            },
            "image": "th"
          }
        },
        {
          "msg": {
            "TypeString": "ClientScenarioTransitionCommandMessage",
            "action": 9,
            "time": 0.0,
            "Scenario": 3
          }
        }
      ],
      "expect": [
        {
          "none_ms": 300
        }
      ]
    },
    {
      "id": "manifest",
      "doc": "question data and the portraits as Required",
      "player": 0,
      "send": [
        {
          "msg": {
            "TypeString": "ClientHoldingScreenCommandMessage",
            "action": 5,
            "time": 0.0,
            "HoldingScreenText": "",
            "HoldingScreenType": 4,
            "OtherPlayerIndex": -1,
            "ShowPortraitPhotoControls": false
          }
        },
        {
          "msg": {
            "TypeString": "QuestionDataMessage",
            "RoundType": 2,
            "QuestionText": "Who would survive a zombie attack?"
          }
        },
        {
          "manifest": [
            {
              "image": "p1",
              "r": 1
            },
            {
              "image": "p2",
              "r": 1
            }
          ]
        }
      ],
      "expect": [
        {
          "msg": "RequestResourceMessage",
          "fields": {
            "ResourceGUID": "$guid:p1"
          }
        },
        {
          "msg": "RequestResourceMessage",
          "fields": {
            "ResourceGUID": "$guid:p2"
          }
        },
        {
          "msg": "AllResourcesReceivedMessage",
          "fields": {
            "Requirements": {
              "type": "array"
            }
          }
        }
      ],
      "order": "any",
      "timeout_ms": 15000
    },
    {
      "id": "vote",
      "doc": "pick the second portrait and confirm",
      "player": 0,
      "send": [
        {
          "msg": {
            "TypeString": "ClientAnswerCommandMessage",
            "action": 3,
            "time": 0.0,
            "roundID": 2,
            "questionBarText": "Who would survive a zombie attack?",
            "jokersEnabled": true,
            "ImageGUIDs": [
              "$guid:p1",
              "$guid:p2"
            ]
          }
        }
      ],
      "screen": "answer",
      "variant": "portraits",
      "page": [
        {
          "do": "tap",
          "target": "answer-2"
        },
        {
          "do": "tap",
          "target": "answer-confirm"
        }
      ],
      "expect": [
        {
          "msg": "AnswerIndexResponseMessage",
          "fields": {
            "AnswerIndex": 2
          }
        }
      ]
    },
    {
      "id": "send-answer",
      "doc": "SendAnswer resends the selection",
      "player": 0,
      "send": [
        {
          "msg": {
            "TypeString": "ClientQuizCommandMessage",
            "action": 16,
            "time": 0.0
          }
        }
      ],
      "screen": "holding",
      "variant": "general",
      "expect": [
        {
          "msg": "AnswerIndexResponseMessage",
          "fields": {
            "AnswerIndex": 2
          }
        }
      ]
    },
    {
      "id": "send-joker",
      "doc": "SendJoker without the toggle",
      "player": 0,
      "send": [
        {
          "msg": {
            "TypeString": "ClientQuizCommandMessage",
            "action": 17,
            "time": 0.0
          }
        }
      ],
      "expect": [
        {
          "msg": "JokerConsumedResponseMessage",
          "fields": {
            "Response": 2,
            "jokerConsumed": false
          }
        }
      ]
    },
    {
      "id": "continue",
      "doc": "ContinueButton",
      "player": 0,
      "send": [
        {
          "msg": {
            "TypeString": "ClientQuizCommandMessage",
            "action": 4,
            "time": 0.0
          }
        }
      ],
      "screen": "continue",
      "variant": "continue",
      "page": [
        {
          "do": "tap",
          "target": "continue"
        }
      ],
      "expect": [
        {
          "msg": "ContinuePressedResponseMessage",
          "fields": {
            "Response": 3
          }
        }
      ]
    }
  ]
}
