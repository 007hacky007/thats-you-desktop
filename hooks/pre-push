#!/usr/bin/env python3
"""Refuse pushes that could publish decompiled code or the private page URL."""
import subprocess
import sys

ZERO = "0" * 40


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout


def main():
    private = git("config", "--get", "iwyk.privateUrl").strip()
    problems = []
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4:
            continue
        _lref, lsha, _rref, rsha = parts
        if lsha == ZERO:
            continue
        rng = [lsha] if rsha == ZERO else [f"{rsha}..{lsha}"]
        touched = git("log", "--name-only", "--pretty=format:", *rng, "--", "local-patches").split()
        if touched:
            problems.append("commits touch local-patches/ (decompiled game code). Convert them first (Plan 7) "
                            "and publish a history that never contained them.")
        if private and private in git("log", "-p", *rng):
            problems.append("the private page address (git config iwyk.privateUrl) appears in the pushed history.")
    if problems:
        sys.stderr.write("pre-push blocked:\n" + "".join(f"- {p}\n" for p in problems))
        sys.exit(1)


main()
