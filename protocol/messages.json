{
  "schema": 1,
  "interfaceVersion": "2016-07-12-1645",
  "jsonTransferId": -7503,
  "doc": "Machine-readable catalogue of the game JSON messages (contract 5.5, protocol.md section 4). dir: p2g phone to game, g2p game to phone. page: true when the port page sends (p2g) or must handle (g2p) the message. Field types: int, long, double, bool, string, string[], object:<Type>, list:<Type>. Fields of a base message come first. Validity rules (valid) are the receiver's checks; rules of the base apply too. default: value a synthesizing sender (the mock console bot) uses.",
  "limits": {
    "textFrameMax": 65536,
    "chunkPayloadMax": 16384,
    "contentTransferMax": 131072,
    "gameAcceptsMax": 131062,
    "phoneUploadMax": 128000,
    "photo": { "width": 480, "height": 640 },
    "drawing": { "width": 384, "height": 512 },
    "thumbnail": { "width": 128, "height": 128 }
  },
  "frames": {
    "hello": { "dir": "p2g", "fields": [ { "name": "t", "type": "string" }, { "name": "token", "type": "string" }, { "name": "uid", "type": "string" } ] },
    "joined": { "dir": "g2p", "fields": [ { "name": "t", "type": "string" } ] },
    "refused": { "dir": "g2p", "fields": [ { "name": "t", "type": "string" }, { "name": "reason", "type": "int" } ] },
    "pending": { "dir": "g2p", "fields": [ { "name": "t", "type": "string" } ] },
    "ping": { "dir": "both", "fields": [ { "name": "t", "type": "string" } ] },
    "msg": { "dir": "both", "fields": [ { "name": "t", "type": "string" }, { "name": "id", "type": "int" }, { "name": "json", "type": "object:Message" } ] },
    "bye": { "dir": "g2p", "fields": [ { "name": "t", "type": "string" }, { "name": "reason", "type": "string" } ] }
  },
  "enums": {
    "eAction": { "NotSet": -1, "Idle": 1, "JokerScreen": 2, "AnswerQuestion": 3, "ContinueButton": 4, "HoldingScreen": 5, "Drawing": 7, "TextEntry": 8, "ScenarioTransition": 9, "RoleCall": 11, "TakeDrawingCanvasPhoto": 12, "WishMessage": 13, "StartGameButtonPrompt": 14, "EndOfGameMessage": 15, "SendAnswer": 16, "SendJoker": 17, "SendTextEntry": 18, "SendDrawing": 19, "UGCSelection": 20, "MessageCollection": 21, "ActivityMessage": 22, "MimicThis": 23, "SendMimicThisPhoto": 24, "QuickDrawTakePhoto": 25, "QuickDrawDrawing": 27, "SendQuickDrawDrawing": 28, "Pause": 29, "Unpause": 30, "EditProfile": 31 },
    "eHoldingScreenType": { "NONE": 0, "BLANK": 1, "OTHER_PLAYER_CHOOSING_UGC": 2, "OTHER_PLAYER_TAKING_PHOTO": 3, "LOOK_AT_TV": 4, "QUICK_DRAW": 5, "CUSTOM_MESSAGE": 6, "QUICK_DRAW_MESSAGE": 7, "REJOIN": 8, "STRING_HACKS": 99 },
    "RoundType": { "TopDrawer": 1, "ThatsYou": 2, "PictureThis": 4, "CanvasOpinion": 8, "ThatsYouGC": 16, "BlankYou": 32, "MimicThis": 64, "WouldYouRather": 128, "QuickDraw": 256, "NoType": 512 },
    "eDisconnectDisplayMessage": { "Default": 0, "GameFull": 2, "ConnectionFailed": 3, "ConnectionRejected": 4, "VersionDisparity": 5, "OnlyOnePlayer": 6, "ConnectionNotAllowed": 7 },
    "ResponseType": { "NotSet": 0, "AnswerIndex": 1, "JokerConsumed": 2, "ContinuePressed": 3, "UsePicPressed": 4, "TextAnswer": 5, "PlayerName": 6, "UGCDeclined": 7, "PlayerCard": 8, "StartButtonPressed": 9, "DeviceInfo": 10, "TopDrawerPhotoTaken": 11 },
    "ImageType": { "Unspecified": 0, "PlayerDrawing": 1, "PlayerPortrait": 2, "DrawingCanvas": 3, "MimicPhoto": 4, "QuickDraw": 5 },
    "Requirement": { "NoRequirement": 0, "Required": 1, "SafeToUnload": 2 },
    "eEnabledUgcState": { "ENABLED": 0, "DISABLED_ONLINE": 1, "DISABLED_INSTALLING": 2, "DISABLED_FIRST_RUN": 4, "DISABLED_UNSPECIFIED_REASON": 8 },
    "AudioCodec": { "NotSet": -1, "Speex": 0, "Opus": 1 },
    "eDeviceSize": { "UNKNOWN": 0, "SMALL": 1, "MEDIUM": 2, "LARGE": 3 },
    "eDeviceOS": { "UNKNOWN": 0, "ANDROID": 1, "IOS": 2, "WINDOWS": 3, "MAC": 4, "LINUX": 5, "WINPHONE": 6 },
    "ScenarioType": { "NoScenario": -1, "Scenario_01": 1, "Scenario_02": 2, "Scenario_03": 3, "Scenario_04": 4, "Scenario_05": 5, "Scenario_06": 6, "Scenario_07": 7, "Scenario_08": 8, "Scenario_09": 9, "Scenario_10": 10, "Scenario_11": 11, "Scenario_12": 12, "InvalidScenarioType": -100 },
    "ContentTransferType": { "AcknowledgeComplete": 4 },
    "RefuseReason": { "NotAllowed": 1, "NoFreeSlots": 2, "OnlyOneAllowed": 3 },
    "eDrawingColour": { "BLACK": 1, "RED": 2, "YELLOW": 3, "BLUE": 4, "PINK": 5, "BROWN": 6, "GREY": 7, "DARK_PINK": 8, "GREEN": 9, "PURPLE": 10, "ORANGE": 11, "WHITE": 12, "KHAKI": 13, "TURQUOISE": 14 }
  },
  "types": {
    "UGCInfo": [
      { "name": "scenarioInt", "type": "int", "default": -1 },
      { "name": "scenario", "type": "int", "enum": "ScenarioType", "default": -100 },
      { "name": "challengeID", "type": "string", "default": "" },
      { "name": "creationID", "type": "string", "default": "" },
      { "name": "set", "type": "bool", "default": false }
    ],
    "ResourceRequirement": [
      { "name": "GUID", "type": "string" },
      { "name": "Rqrmnt", "type": "int", "enum": "Requirement", "default": 1 }
    ]
  },
  "messages": {
    "ClientRequestPlayerIDMessage": { "dir": "p2g", "page": true,
      "doc": "after InterfaceVersionMessage and SessionStateMessage; reply AssignPlayerIDAndSlotMessage",
      "replyTo": ["SessionStateMessage"],
      "fields": [ { "name": "UID", "type": "string", "default": "bot-uid" } ],
      "valid": [ { "field": "UID", "op": "nonempty" } ] },
    "DeviceInfoMessage": { "dir": "p2g", "page": true,
      "doc": "sent on EditProfile (action 31); no reply",
      "replyTo": ["ClientQuizCommandMessage:31"],
      "fields": [
        { "name": "Response", "type": "int", "enum": "ResponseType", "default": 10 },
        { "name": "DeviceSize", "type": "int", "enum": "eDeviceSize", "default": 1 },
        { "name": "DeviceOS", "type": "int", "enum": "eDeviceOS", "default": 5 },
        { "name": "DeviceModel", "type": "string", "default": "Desktop" },
        { "name": "DeviceType", "type": "string", "default": "Desktop" },
        { "name": "DeviceUID", "type": "string", "default": "bot-uid" },
        { "name": "DeviceOperatingSystem", "type": "string", "default": "Web" },
        { "name": "DeviceName", "type": "string", "optional": true, "doc": "in the game class, never sent" } ],
      "valid": [ { "field": "Response", "op": "eq", "value": 10 },
                 { "field": "DeviceSize", "op": "in", "value": [1, 2, 3] },
                 { "field": "DeviceOS", "op": "in", "value": [1, 2, 3, 4, 5, 6] } ] },
    "ClientPlayerProfileMessage": { "dir": "p2g", "page": true,
      "doc": "profile confirm, after the portrait upload (ImgType 2) and its TrophyPhotoFXInfoMessage",
      "fields": [
        { "name": "playerName", "type": "string", "default": "BOT" },
        { "name": "uppercasePlayerName", "type": "string", "default": "BOT" },
        { "name": "deviceCultureName", "type": "string", "default": "en-US" },
        { "name": "ugcInfo", "type": "object:UGCInfo" },
        { "name": "isGuest", "type": "int", "default": 0 },
        { "name": "playerCardId", "type": "string", "default": "CARD_1" } ],
      "valid": [ { "field": "playerName", "op": "nonempty" },
                 { "field": "uppercasePlayerName", "op": "nonempty" },
                 { "field": "deviceCultureName", "op": "nonempty" },
                 { "field": "playerCardId", "op": "in", "value": ["CARD_1", "CARD_2", "CARD_3", "CARD_4", "CARD_5", "CARD_6", "CARD_7", "CARD_8", "CARD_9", "CARD_10", "CARD_11", "CARD_12"] },
                 { "field": "isGuest", "op": "in", "value": [0, 1] },
                 { "field": "ugcInfo.set", "op": "eq", "value": false } ] },
    "ClientDisconnectMessage": { "dir": "p2g", "page": true, "doc": "deliberate leave", "fields": [] },
    "AnswerIndexResponseMessage": { "dir": "p2g", "page": true,
      "doc": "answer confirm, again on SendAnswer (16); 1-based position, Blank You PlayerID label, WYR AnswerId; -2 no answer",
      "replyTo": ["ClientAnswerCommandMessage", "ClientQuizCommandMessage:16"],
      "fields": [ { "name": "AnswerIndex", "type": "int", "default": 1 } ],
      "valid": [ { "field": "AnswerIndex", "op": "ge", "value": -2 } ] },
    "JokerConsumedResponseMessage": { "dir": "p2g", "page": true,
      "replyTo": ["ClientQuizCommandMessage:17"],
      "fields": [ { "name": "Response", "type": "int", "enum": "ResponseType", "default": 2 },
                  { "name": "jokerConsumed", "type": "bool", "default": false } ],
      "valid": [ { "field": "Response", "op": "eq", "value": 2 } ] },
    "ContinuePressedResponseMessage": { "dir": "p2g", "page": true,
      "replyTo": ["ClientQuizCommandMessage:4"],
      "fields": [ { "name": "Response", "type": "int", "enum": "ResponseType", "default": 3 } ],
      "valid": [ { "field": "Response", "op": "eq", "value": 3 } ] },
    "UsePicPressedResponseMessage": { "dir": "p2g", "page": true,
      "doc": "Top Drawer and QuickDraw photo used",
      "replyTo": ["ClientTopDrawerTakePhotoCommandMessage", "ClientQuickDrawTakePhotoCommandMessage"],
      "fields": [ { "name": "Response", "type": "int", "enum": "ResponseType", "default": 4 } ],
      "valid": [ { "field": "Response", "op": "eq", "value": 4 } ] },
    "TextAnswerReponseMessage": { "dir": "p2g", "page": true,
      "doc": "spelling as in the game; reply to SendTextEntry (18)",
      "replyTo": ["ClientQuizCommandMessage:18"],
      "fields": [ { "name": "Response", "type": "int", "enum": "ResponseType", "default": 5 },
                  { "name": "Text", "type": "string", "default": "" } ],
      "valid": [ { "field": "Response", "op": "eq", "value": 5 } ] },
    "StartGameButtonPressedResponseMessage": { "dir": "p2g", "page": true,
      "doc": "start hold completed; the game does not validate it",
      "replyTo": ["ClientQuizCommandMessage:14"],
      "fields": [ { "name": "Response", "type": "int", "enum": "ResponseType", "default": 9 } ],
      "valid": [ { "field": "Response", "op": "eq", "value": 9 } ] },
    "TopDrawerPhotoTakenResponseMessage": { "dir": "p2g", "page": true,
      "doc": "Top Drawer shutter",
      "replyTo": ["ClientTopDrawerTakePhotoCommandMessage"],
      "fields": [ { "name": "Response", "type": "int", "enum": "ResponseType", "default": 11 } ],
      "valid": [ { "field": "Response", "op": "eq", "value": 11 } ] },
    "TrophyPhotoFXInfoMessage": { "dir": "p2g", "page": true,
      "doc": "after every photo upload",
      "fields": [ { "name": "ImageGUID", "type": "string" },
                  { "name": "usesFX", "type": "bool", "default": false } ] },
    "TrophyDrawingColouringInfoMessage": { "dir": "p2g", "page": true,
      "doc": "after every drawing upload; masks are bit (1 << colour id) over eDrawingColour",
      "fields": [ { "name": "ImageGUID", "type": "string" },
                  { "name": "ColoursAvailable", "type": "int", "default": 32766 },
                  { "name": "ColoursUsed", "type": "int", "default": 2 } ],
      "valid": [ { "field": "ColoursAvailable", "op": "ge", "value": 0 },
                 { "field": "ColoursUsed", "op": "ge", "value": 0 } ] },
    "ClientImageResourceContentTransferMessage": { "dir": "p2g", "page": true, "content": true,
      "doc": "upload header, immediately followed by the binary transfer with the same TransferID",
      "fields": [ { "name": "TransferID", "type": "int" },
                  { "name": "ImageGUID", "type": "string" },
                  { "name": "ImgType", "type": "int", "enum": "ImageType" } ],
      "valid": [ { "field": "TransferID", "op": "gt", "value": 0 },
                 { "field": "ImgType", "op": "in", "value": [0, 1, 2, 3, 4, 5] } ] },
    "RequestResourceMessage": { "dir": "p2g", "page": true,
      "doc": "resource handshake; reply ImageResourceContentTransferMessage + JPEG",
      "replyTo": ["ResourceRequirementsMessage"],
      "fields": [ { "name": "ResourceGUID", "type": "string" } ] },
    "AllResourcesReceivedMessage": { "dir": "p2g", "page": true,
      "doc": "once every Required GUID is held; lists every Required GUID with Rqrmnt 1",
      "replyTo": ["ResourceRequirementsMessage"],
      "fields": [ { "name": "Requirements", "type": "list:ResourceRequirement", "default": [] } ] },
    "ClientSendChatLogMessage": { "dir": "p2g", "page": false,
      "doc": "optional chat, not required",
      "fields": [ { "name": "PlayerId", "type": "int" }, { "name": "Message", "type": "string" }, { "name": "TickTimestamp", "type": "long" } ] },
    "ClientImageUGCContentMessage": { "dir": "p2g", "page": false, "content": true,
      "doc": "reply to UGCSelection with a drawing; UGC is not ported",
      "fields": [ { "name": "challengeId", "type": "string" }, { "name": "metadata", "type": "string" },
                  { "name": "imageId", "type": "string" }, { "name": "TransferID", "type": "int" } ] },
    "ClientQuestionUGCContentMessage": { "dir": "p2g", "page": false,
      "doc": "reply to UGCSelection with written content; UGC is not ported",
      "fields": [ { "name": "challengeId", "type": "string" }, { "name": "metadata", "type": "string" }, { "name": "question", "type": "string" } ] },
    "ClientAudioClipContentTransferMessage": { "dir": "p2g", "page": false, "content": true,
      "doc": "voice chat clip; not used by the page",
      "fields": [ { "name": "TransferID", "type": "int" }, { "name": "Codec", "type": "int", "enum": "AudioCodec" } ],
      "valid": [ { "field": "TransferID", "op": "gt", "value": 0 }, { "field": "Codec", "op": "ne", "value": -1 } ] },
    "CancelContentSendMessage": { "dir": "p2g", "page": false,
      "fields": [ { "name": "TransferID", "type": "int" } ],
      "valid": [ { "field": "TransferID", "op": "gt", "value": -1 } ] },
    "AcknowledgeContentTransferMessage": { "dir": "both", "page": false,
      "doc": "accepted by the game, never sent by the original app nor to phones",
      "fields": [ { "name": "TransferType", "type": "int", "enum": "ContentTransferType" }, { "name": "TransferID", "type": "int" }, { "name": "Successful", "type": "bool" } ],
      "valid": [ { "field": "TransferType", "op": "eq", "value": 4 }, { "field": "TransferID", "op": "gt", "value": -1 } ] },
    "WishResponseMessage": { "dir": "p2g", "page": false, "unused": true, "doc": "never sent by the app",
      "fields": [ { "name": "Response", "type": "int" }, { "name": "Text", "type": "string" } ] },
    "JoinResponseMessage": { "dir": "p2g", "page": false, "unused": true, "doc": "never sent by the app", "fields": [] },
    "PlayerNameResponseMessage": { "dir": "p2g", "page": false, "unused": true, "doc": "never sent by the app",
      "fields": [ { "name": "Response", "type": "int" }, { "name": "Text", "type": "string" } ] },
    "PlayerCardResponseMessage": { "dir": "p2g", "page": false, "unused": true, "doc": "never sent by the app; no game class", "fields": [] },
    "UGCDeclinedMessage": { "dir": "p2g", "page": false, "unused": true, "doc": "never sent by the app; no game class", "fields": [] },

    "InterfaceVersionMessage": { "dir": "g2p", "page": true,
      "doc": "on join (socket path); the page compares with interfaceVersion",
      "fields": [ { "name": "InterfaceVersion", "type": "string", "default": "2016-07-12-1645" } ],
      "valid": [ { "field": "InterfaceVersion", "op": "nonempty" } ] },
    "SessionStateMessage": { "dir": "g2p", "page": true,
      "fields": [ { "name": "SessionID", "type": "int" } ],
      "valid": [ { "field": "SessionID", "op": "gt", "value": 0 } ] },
    "AssignPlayerIDAndSlotMessage": { "dir": "g2p", "page": true,
      "doc": "join, rejoin, slot renumbering (repeated)",
      "replyTo": ["ClientRequestPlayerIDMessage"],
      "fields": [ { "name": "PlayerID", "type": "int" }, { "name": "SlotID", "type": "int" }, { "name": "UDPPortOffset", "type": "int", "default": 0 },
                  { "name": "DisplayName", "type": "string", "default": "" }, { "name": "PSNID", "type": "string", "default": "" } ],
      "valid": [ { "field": "PlayerID", "op": "ge", "value": 0 }, { "field": "SlotID", "op": "ge", "value": 0 }, { "field": "UDPPortOffset", "op": "ge", "value": 0 } ] },
    "DisconnectCommandMessage": { "dir": "g2p", "page": true,
      "fields": [ { "name": "Msg", "type": "int", "enum": "eDisconnectDisplayMessage" } ] },
    "ClientOnlineStateMessage": { "dir": "g2p", "page": true, "fields": [ { "name": "IsOnline", "type": "bool", "default": false } ] },
    "ClientUGCStateMessage": { "dir": "g2p", "page": true, "fields": [ { "name": "ugcState", "type": "int", "enum": "eEnabledUgcState", "default": 0 } ] },
    "JoinLeaveMessage": { "dir": "g2p", "page": true, "doc": "online only; ignored", "fields": [] },
    "PlayerJoinedMessage": { "dir": "g2p", "page": true,
      "fields": [ { "name": "CurrentPlayerID", "type": "int" }, { "name": "OldPlayerID", "type": "int" }, { "name": "SlotID", "type": "int" } ],
      "valid": [ { "field": "CurrentPlayerID", "op": "ne", "value": -1 }, { "field": "SlotID", "op": "ne", "value": -1 } ] },
    "PlayerNameQuizStateMessage": { "dir": "g2p", "page": true,
      "fields": [ { "name": "PlayerName", "type": "string" }, { "name": "PlayerID", "type": "int" } ],
      "valid": [ { "field": "PlayerName", "op": "ne", "value": "***NOTSETPLAYERNAME" }, { "field": "PlayerID", "op": "ge", "value": 0 } ] },
    "PlayerLeftMessage": { "dir": "g2p", "page": true,
      "fields": [ { "name": "PlayerID", "type": "int" } ],
      "valid": [ { "field": "PlayerID", "op": "ne", "value": -1 } ] },
    "RejoiningClientOwnProfileMessage": { "dir": "g2p", "page": true,
      "fields": [ { "name": "Name", "type": "string" }, { "name": "PortraitGUID", "type": "string" }, { "name": "CardID", "type": "string" } ],
      "valid": [ { "field": "Name", "op": "nonempty" }, { "field": "CardID", "op": "nonempty" } ] },
    "ClientGameIDMessage": { "dir": "g2p", "page": true,
      "doc": "\"1\" + GUID front end, \"2\" + GUID in game",
      "fields": [ { "name": "GameID", "type": "string" } ],
      "valid": [ { "field": "GameID", "op": "nonempty" } ] },
    "SyncJokersQuizStateMessage": { "dir": "g2p", "page": true,
      "fields": [ { "name": "NumJokers", "type": "int" } ],
      "valid": [ { "field": "NumJokers", "op": "ge", "value": 0 } ] },
    "ClientReceiveChatLogMessage": { "dir": "g2p", "page": false,
      "fields": [ { "name": "PlayerId", "type": "int" }, { "name": "Message", "type": "string" }, { "name": "TickTimestamp", "type": "long" },
                  { "name": "PSNID", "type": "string" }, { "name": "ClientUID", "type": "string" }, { "name": "DisplayName", "type": "string" }, { "name": "SlotID", "type": "int" } ] },
    "QuestionDataMessage": { "dir": "g2p", "page": true,
      "fields": [ { "name": "RoundType", "type": "int", "enum": "RoundType" }, { "name": "QuestionText", "type": "string" } ] },
    "ResourceRequirementsMessage": { "dir": "g2p", "page": true,
      "doc": "only non-zero entries; answered with RequestResourceMessage for missing Required images and AllResourcesReceivedMessage",
      "fields": [ { "name": "Requirements", "type": "list:ResourceRequirement", "default": [] } ] },
    "ImageResourceContentTransferMessage": { "dir": "g2p", "page": true, "content": true,
      "fields": [ { "name": "TransferID", "type": "int" }, { "name": "ImageGUID", "type": "string" }, { "name": "Acknowledge", "type": "bool", "default": true } ],
      "valid": [ { "field": "TransferID", "op": "ge", "value": 1 }, { "field": "ImageGUID", "op": "nonempty" } ] },
    "PortraitThumbnailContentTransferMessage": { "dir": "g2p", "page": true, "content": true,
      "fields": [ { "name": "TransferID", "type": "int" }, { "name": "ClientUID", "type": "string" } ],
      "valid": [ { "field": "TransferID", "op": "ge", "value": 1 }, { "field": "ClientUID", "op": "nonempty" } ] },
    "AnswerTextQuizStateMessage": { "dir": "g2p", "page": true,
      "doc": "Blank You card; PlayerID is a label",
      "fields": [ { "name": "AnswerText", "type": "string" }, { "name": "PlayerID", "type": "int" } ],
      "valid": [ { "field": "AnswerText", "op": "ne", "value": "***NOTSETANSWERTEXT" }, { "field": "PlayerID", "op": "ge", "value": 0 } ] },
    "WouldYouRatherAnswerTextQuizMessage": { "dir": "g2p", "page": true,
      "fields": [ { "name": "AnswerText", "type": "string" }, { "name": "AnswerId", "type": "int" } ],
      "valid": [ { "field": "AnswerText", "op": "ne", "value": "---NOTSETTEXT---" }, { "field": "AnswerId", "op": "ge", "value": 0 } ] },
    "ClientQuizCommandMessage": { "dir": "g2p", "page": true,
      "doc": "base command; handled actions 4, 14, 15, 16, 17, 18, 19, 24, 27, 28, 29, 30, 31; ignored 1, 2, 11, 13, 21, 22",
      "fields": [ { "name": "action", "type": "int", "enum": "eAction" }, { "name": "time", "type": "double", "default": 0.0 } ],
      "valid": [ { "field": "action", "op": "ne", "value": -1 } ] },
    "ClientHoldingScreenCommandMessage": { "dir": "g2p", "page": true, "base": "ClientQuizCommandMessage",
      "fields": [ { "name": "HoldingScreenText", "type": "string" }, { "name": "HoldingScreenType", "type": "int", "enum": "eHoldingScreenType" },
                  { "name": "OtherPlayerIndex", "type": "int", "default": -1 }, { "name": "ShowPortraitPhotoControls", "type": "bool", "default": false } ],
      "valid": [ { "field": "action", "op": "eq", "value": 5 },
                 { "field": "HoldingScreenText", "op": "ne", "value": "***NOTSETHOLDINGSCREENTEXT" },
                 { "field": "HoldingScreenType", "op": "ne", "value": 0 },
                 { "field": "OtherPlayerIndex", "op": "gt", "value": 0, "when": { "field": "HoldingScreenType", "op": "in", "value": [2, 3] } } ] },
    "ClientQuickDrawHoldingScreenCommandMessage": { "dir": "g2p", "page": true, "base": "ClientHoldingScreenCommandMessage", "inheritValid": false,
      "doc": "carries the holding-text sentinel, which must be accepted",
      "fields": [ { "name": "ImageGUID", "type": "string" }, { "name": "Heading", "type": "string" }, { "name": "Description", "type": "string" },
                  { "name": "NumberOfDrawingsRemaining", "type": "int" }, { "name": "PlayerName", "type": "string" } ],
      "valid": [ { "field": "action", "op": "eq", "value": 5 }, { "field": "HoldingScreenType", "op": "eq", "value": 5 } ] },
    "ClientTextEntryCommandMessage": { "dir": "g2p", "page": true, "base": "ClientQuizCommandMessage",
      "fields": [ { "name": "TitleText", "type": "string" } ],
      "valid": [ { "field": "action", "op": "eq", "value": 8 }, { "field": "TitleText", "op": "ne", "value": "***NOTSETTEXTENTRYTITLE" } ] },
